{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Plugin Contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "description",
    "components",
    "targets",
    "policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "IMPLEMENTED",
        "OPERATIONAL_LOCAL",
        "INTEGRATED",
        "PRODUCTION_OBSERVED"
      ]
    }
  },
  "additionalProperties": true
}
